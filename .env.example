# ============================================================
# AD 域控自助解锁平台 配置模板
# 复制本文件为 .env 并填写真实值（.env 不要提交到代码仓库）
# ============================================================

# ---- AD / LDAP ----
# 域控地址，强烈建议使用 LDAPS 加密：ldaps://dc01.company.local
# 也支持 ldap://dc01.company.local（明文，仅限内网且确认安全）
AD_SERVER=ldaps://dc01.company.local

# AD 域名（大写，用于拼接管理员账号）
AD_DOMAIN=COMPANY.LOCAL

# 解锁专用服务账号（建议最低权限委派，见 README）
AD_ADMIN_USER=svc_adunlock
AD_ADMIN_PASSWORD=ChangeMe_StrongPassword

# 绑定账号：默认自动拼接为 DOMAIN\账号（NTLM）。
# 若贵司使用 LDAP 简单绑定，可改为完整 DN，例如：
# AD_BIND_USER=CN=S_LdapAuth,CN=Users,DC=ams,DC=com
# AD_BIND_USER=

# 用户搜索根（建议限定到用户所在 OU，缩小搜索范围）
AD_SEARCH_BASE=DC=company,DC=local

# 工号对应 AD 属性：employeeID（默认）/ 或改为 sAMAccountName
AD_USER_ID_ATTR=employeeID

# 锁定判定窗口（分钟），建议与域策略「账户锁定时间」一致
AD_LOCKOUT_WINDOW_MINUTES=60

# 连接超时（秒）
AD_CONNECT_TIMEOUT=5
AD_RECEIVE_TIMEOUT=10

# ---- 输入校验 / 安全 ----
# 工号格式白名单（默认 3-40 位字母数字及 _ - .）
WORKER_ID_PATTERN=^[A-Za-z0-9_\-\.]{3,40}$

# 单 IP 限流：60 秒内最多 10 次
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# 若前端有反向代理（nginx/IIS ARR），置 true 以信任 X-Forwarded-For
TRUST_PROXY=false

# ---- 管理页面（解锁记录查询）----
# 设置后启用 /admin 管理页面（需登录）；留空则禁用管理功能
ADMIN_PASSWORD=please-set-a-strong-admin-password

# Flask session 密钥：生产务必设置固定随机值（如 openssl rand -hex 32），
# 否则服务重启后所有管理员需重新登录
APP_SECRET_KEY=please-set-a-long-random-secret

# 管理员会话有效期（小时），到期自动退出
ADMIN_SESSION_HOURS=8

# ---- 服务运行 ----
HOST=0.0.0.0
PORT=5000
DEBUG=false
